{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/aars-no/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Tiempos Text|Tiempos Headline))/i]",
        "message": "Font not provided by the design system. Available: Tiempos Text, Tiempos Headline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Arrow> doesn't accept that prop. Declared props: direction, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|kicker|title|linkLabel|href|width|style|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: image, kicker, title, linkLabel, href, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|selected|href|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, selected, href, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light|accent|white)$/]",
        "message": "<Button> tone must be one of 'dark' | 'light' | 'accent' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:desktop|tablet|mobile)$/]",
        "message": "<Button> size must be one of 'desktop' | 'tablet' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Company'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|logo|key|ref|className|style|children)$/]",
        "message": "<Company> doesn't accept that prop. Declared props: name, logo."
      },
      {
        "selector": "JSXOpeningElement[name.name='CookieBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|acceptLabel|onAccept|style|key|ref|className|style|children)$/]",
        "message": "<CookieBanner> doesn't accept that prop. Declared props: text, acceptLabel, onAccept, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|tone|width|style|key|ref|className|style|children)$/]",
        "message": "<EmailField> doesn't accept that prop. Declared props: placeholder, value, onChange, tone, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailField'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<EmailField> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureSplit'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|body|cta|ctaHref|imageSide|background|height|style|key|ref|className|style|children)$/]",
        "message": "<FeatureSplit> doesn't accept that prop. Declared props: image, title, body, cta, ctaHref, imageSide, background, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureSplit'] > JSXAttribute[name.name='imageSide'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<FeatureSplit> imageSide must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:breakpoint|address|email|practical|showNewsletter|language|onTop|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: breakpoint, address, email, practical, showNewsletter, language, onTop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|tablet|mobile)$/]",
        "message": "<Footer> breakpoint must be one of 'desktop' | 'tablet' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|headline|cta|ctaHref|height|align|style|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: image, headline, cta, ctaHref, height, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Hero> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute > JSXIdentifier[name!=/^(?:breakpoint|tone|links|menuLabel|onMenuClick|wordmarkColor|style|key|ref|className|style|children)$/]",
        "message": "<Menu> doesn't accept that prop. Declared props: breakpoint, tone, links, menuLabel, onMenuClick, wordmarkColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|tablet|mobile)$/]",
        "message": "<Menu> breakpoint must be one of 'desktop' | 'tablet' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|accent)$/]",
        "message": "<Menu> tone must be one of 'light' | 'dark' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|items|activeItem|onSelect|onClose|language|width|style|key|ref|className|style|children)$/]",
        "message": "<MenuOverlay> doesn't accept that prop. Declared props: open, items, activeItem, onSelect, onClose, language, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|level|align|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: children, tone, level, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|dark|light|white)$/]",
        "message": "<SectionHeading> tone must be one of 'accent' | 'dark' | 'light' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:h1|h2|h3|h4)$/]",
        "message": "<SectionHeading> level must be one of 'h1' | 'h2' | 'h3' | 'h4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|items|columns|style|key|ref|className|style|children)$/]",
        "message": "<StatGrid> doesn't accept that prop. Declared props: heading, items, columns, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|tone|size|external|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, tone, size, external, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light|muted|accent)$/]",
        "message": "<TextLink> tone must be one of 'dark' | 'light' | 'muted' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:body|caption|menu-header|large)$/]",
        "message": "<TextLink> size must be one of 'body' | 'caption' | 'menu-header' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|color|src|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: height, color, src, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
